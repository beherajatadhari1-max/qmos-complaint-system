# ═══════════════════════════════════════════════════════════════════════════════
# QMOS — Quality Management Operating System
# Environment Variables Template
# Copy this file to .env.local and fill in your values before running the app.
# NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase (Required) ────────────────────────────────────────────────────────
# Your Supabase project URL — found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key — safe to expose to browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — KEEP SECRET, server-side only
# Used for admin operations (bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Application (Required) ─────────────────────────────────────────────────────
# Full URL of the app — used for generating links in emails/reports
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Node environment: development | production | test
NODE_ENV=development

# Port for PM2 / Next.js server
PORT=5000

# ── Email / SMTP (Optional — for alert emails) ────────────────────────────────
# Configure to enable escalation emails and daily brief delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Comma-separated list of email addresses to receive quality alerts
ALERT_TO=qualityhead@yourcompany.com,plantmanager@yourcompany.com

# ── WhatsApp Business API (Optional — for WhatsApp alerts) ───────────────────
# Meta WhatsApp Business API credentials for daily brief / escalation alerts
WA_ACCESS_TOKEN=your-whatsapp-access-token
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_RECIPIENT_NUMBERS=+919999999999,+918888888888
WA_TEMPLATE_NAME=quality_daily_brief
WA_USE_TEMPLATE=false

# ── Scheduled Tasks (Optional) ────────────────────────────────────────────────
# Secret used to authenticate the daily report cron endpoint
DAILY_REPORT_SECRET=your-secret-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# Setup Steps:
# 1. Create a Supabase project at https://supabase.com
# 2. Run the SQL migrations from /supabase/migrations/
# 3. Copy this file → .env.local and fill in Supabase credentials
# 4. npm install && pm2 start ecosystem.config.js
# 5. Visit http://localhost:5000 — login with your configured admin credentials
# ═══════════════════════════════════════════════════════════════════════════════
